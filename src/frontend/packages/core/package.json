{
  "name": "@openfun/jitsi-magnify",
  "private": false,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc && vite build --watch",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 -s public",
    "react-router-dom": "6.4.1",
    "test": "vitest run ",
    "test-watch": "vitest --ui",
    "coverage": "vitest run --coverage",
    "compile-translations": "./i18n/compile-translations.cjs",
    "extract-translations": "formatjs extract './**/*.ts*'  --ignore ./node_modules --ignore './**/*.d.ts' --ignore ./tsconfig.tsbuildinfo --ignore './**/*.stories.ts*' --out-file './i18n/frontend.json' --id-interpolation-pattern '[sha512:contenthash:base64:6]' --format crowdin",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check src",
    "format:write": "prettier --write src",
    "build-theme": "cunningham -g css,ts -o src"
  },
  "dependencies": {
    "@tanstack/react-query-devtools": "5.102.8",
    "formik": "2.4.9",
    "grommet": "2.56.1",
    "grommet-icons": "4.14.0",
    "keycloak-js": "26.2.4",
    "validator": "13.15.35",
    "yup": "1.7.1"
  },
  "peerDependencies": {
    "@jitsi/react-sdk": "1.4.4",
    "@openfun/cunningham-react": "4.0.0",
    "@tanstack/react-query": "5.102.8",
    "axios": "1.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intl": "10.1.26",
    "react-router-dom": "7.18.3",
    "styled-components": "<6"
  },
  "devDependencies": {
    "@bbbtech/storybook-formik": "4.0.0",
    "@faker-js/faker": "10.6.0",
    "@formatjs/cli": "6.16.23",
    "@formatjs/intl-relativetimeformat": "12.3.13",
    "@lib/eslint-config": "*",
    "@lib/typescript-configs": "*",
    "@openfun/cunningham-react": "4.0.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@storybook/addon-actions": "9.0.8",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "10.6.0",
    "@storybook/cli": "10.6.0",
    "@storybook/preset-scss": "1.0.3",
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@storybook/testing-library": "0.2.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "13.3.0",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/styled-components": "5.1.36",
    "@types/validator": "13.15.10",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/ui": "5.0.0",
    "babel-plugin-react-intl": "8.2.25",
    "cljs-merge": "1.1.1",
    "intl-pluralrules": "2.0.1",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.6.0",
    "storybook-addon-react-router-v6": "3.0.0",
    "styled-components": "5.3.11",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "typescript-plugin-css-modules": "5.2.0",
    "use-debounce": "10.1.1",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.1.0",
    "vitest": "5.0.0",
    "vitest-dom": "0.1.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "msw": {
    "workerDirectory": "public"
  }
}
