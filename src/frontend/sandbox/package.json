{
  "name": "sandbox",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test-watch": "vitest --ui",
    "coverage": "vitest run --coverage",
    "compile-translations": "../packages/core/i18n/compile-translations.cjs ./i18n/locales/*.json",
    "extract-translations": "formatjs extract './**/*.ts*' --ignore ./node_modules --ignore './**/*.d.ts' --ignore './**/*.stories.ts*' --out-file './i18n/frontend.json' --id-interpolation-pattern '[sha512:contenthash:base64:6]' --format crowdin",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check src ",
    "format:write": "prettier --write src",
    "build-theme": "cunningham -g css,ts -o src"
  },
  "dependencies": {
    "@jitsi/react-sdk": "1.4.4",
    "@openfun/cunningham-react": "4.0.0",
    "@openfun/jitsi-magnify": "*",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "@types/styled-components": "5.1.36",
    "axios": "1.20.0",
    "grommet": "2.56.1",
    "grommet-icons": "4.14.0",
    "polished": "4.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "10.2.1",
    "react-router-dom": "7.18.3",
    "react-scripts": "5.0.1",
    "stream": "npm:stream-browserify",
    "stream-browserify": "3.0.0",
    "styled-components": "5.3.11",
    "validator": "13.15.35",
    "web-vitals": "6.2.1"
  },
  "devDependencies": {
    "@lib/eslint-config": "*",
    "@lib/typescript-configs": "*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "13.0.0",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/ui": "5.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.0",
    "vitest-dom": "0.1.1"
  }
}
